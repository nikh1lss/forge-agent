{
  "name": "forge-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "forge-tui": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build:engine": "cd .. && ./gradlew installDist -q",
    "start": "npm run build:engine && npm run build && node dist/cli.js",
    "dev": "npm run build:engine && tsx src/cli.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
